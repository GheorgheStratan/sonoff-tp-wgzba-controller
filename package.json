{
  "name": "sonoff-thermostat",
  "productName": "Sonoff Thermostat",
  "version": "1.0.0",
  "description": "Desktop app to control the SONOFF TP-WGZBA thermostat through a Zigbee USB dongle",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "js-yaml": "5.5.0",
    "zigbee-herdsman": "11.2.0",
    "zigbee-herdsman-converters": "26.125.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.sonoff.thermostat",
    "productName": "Sonoff Thermostat",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/@serialport/**"],
    "npmRebuild": false,
    "win": { "target": "nsis", "icon": "src/renderer/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sonoff Thermostat"
    }
  }
}
